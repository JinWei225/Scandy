# ==============================================================================
# Scandy Unified .gitignore Configuration
# ==============================================================================

# --- Local Docker configuration (.env.example is the tracked template) ---
.env

# --- Personal deployment scripts (public copy lives in deployment/) ---
dev-deployment/

# --- Personal Data & Databases (DO NOT UPLOAD) ---
# Receipt images: uploads land here at runtime, and any test receipts you add
# are photographs of real transactions. Never commit them.
backend/img/
# Labels for those receipts — merchant, date and amount of real purchases.
# ground_truth.example.json shows the format and is tracked in its place.
backend/bench/ground_truth.json

backend/database.sqlite
backend/accounts.json
backend/budgets.json
backend/subscriptions.json
*.sqlite
*.db

# --- Benchmark output (regenerate with backend/bench/compare_pipelines.py) ---
backend/bench/results/

# --- Log Files ---
*.log
*.pid
backend/waitress.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python Environment & Caches ---
.venv/
__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg-info/

# --- Node/Frontend Dependencies & Builds ---
node_modules/
frontend_flutter/build/
frontend_flutter/.dart_tool/

# --- IDEs & Editors ---
.vscode/
.idea/
.antigravitycli/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS System Files ---
.DS_Store
**/.DS_Store
Thumbs.db

# --- Temporary Consolidation Backup ---
git_backups/