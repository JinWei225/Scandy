app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Generated from lib/l10n/*.arb by gen-l10n on every `pub get` and `build`
# (pubspec sets `generate: true`, l10n.yaml says where). Not checked in: it is
# derived, and a tracked copy invites someone to edit the Dart instead of the
# .arb it comes from.
lib/l10n/app_localizations*.dart

# Local Supabase defines for `flutter run --dart-define-from-file=.dart-defines.json`
.dart-defines.json
