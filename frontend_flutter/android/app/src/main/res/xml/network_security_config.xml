<?xml version="1.0" encoding="utf-8"?>
<!--
  Scandy's backend is self-hosted and normally reached over plain HTTP at
  whatever address the host machine happens to have (10.0.2.2 on the emulator,
  something like 192.168.1.42 on a home network). Android has blocked cleartext
  by default since API 28.

  Cleartext is therefore permitted app-wide. Scoping it to private address
  ranges is not expressible here: network-security-config matches host *names*,
  not CIDR blocks, so a `192.168.1.1` entry would not cover `192.168.1.42` and
  the app would fail with a confusing connection error instead.

  TRADE-OFF: traffic to the backend — which includes your transaction data — is
  unencrypted and readable by anything on the same network. That is acceptable
  on a trusted LAN and NOT acceptable over public Wi-Fi. If you ever expose the
  backend beyond your own network, put it behind HTTPS and delete this file
  along with the android:networkSecurityConfig attribute in AndroidManifest.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
